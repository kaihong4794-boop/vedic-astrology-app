# Copy this file to `.env` for local development (do not commit `.env`).
# On Render, set these as environment variables in the service dashboard instead.

# Required: your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use for generating the reading.
# Defaults to claude-opus-5 (highest quality, higher cost).
# Cheaper alternatives: claude-sonnet-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5

# Required to use the /admin history page. Pick your own password;
# username is fixed as "admin". Without this set, /admin is disabled.
ADMIN_PASSWORD=change-me

# Optional: Postgres connection string for persisting generated readings
# (used by /admin). If unset, falls back to a local SQLite file
# (backend/local_readings.db) — fine for local dev, but Render's free web
# service has no persistent disk, so production needs a real Postgres URL
# (Render's "Internal Database URL" from a Postgres instance you create).
DATABASE_URL=postgresql://user:password@host:5432/dbname
